{
  "permissions": {
    "ask": [
      "Edit(/specs/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "if": "Write(/specs/**)",
            "command": "python3",
            "args": [
              "${CLAUDE_PROJECT_DIR}/scripts/spec_guard.py"
            ],
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Edit|MultiEdit|NotebookEdit|Bash|PowerShell|mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": [
              "${CLAUDE_PROJECT_DIR}/scripts/spec_guard.py"
            ],
            "timeout": 10
          }
        ]
      }
    ]
  }
}
